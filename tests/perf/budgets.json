// What the scenarios of the performance tests may cost.
// See tests/perf/PerformanceTestSupport.h, and `scripts/dev.ps1 perf` for the numbers of
// this machine.
//
// Counts and sizes are the same on every machine. They leave room for a small addition
// and no more: a change that exceeds one either has a reason, and raises the budget in
// the same commit, or has a mistake.
//
// Times depend on the machine and on what else it is doing, so their budgets are many
// times what a desktop GPU needs. They catch what has become very much slower, not what
// has become a little slower; for that, compare runs of `dev.ps1 perf`. They are checked
// in optimized builds only.
{
    // The showcase project, as a game shows it.
    "showcase": {
        // Draw calls and triangles are those of all passes together: a solid surface is
        // drawn by the depth pre-pass and again by the base pass, a translucent one
        // once, and whatever stands in the light of a light that casts shadows once
        // more for each of its shadow maps. Two thirds of both are the shadow maps. The
        // hoist is in them with its frame and with its cable, which is skinned: three
        // draw calls a pass that sees all of it. The rack by the wall is two balls and
        // four boxes more - the balls of 960 triangles each, in every pass and every
        // shadow map that sees them - and the sentry a capsule of 1024, which six of
        // them see. The two bollards, placed from a prefab, are a post and a ball each:
        // the posts are drawn with the pillar, which is of the same mesh and material,
        // and the balls are a draw call of their own in each pass and shadow map that
        // sees them - six draw calls and 11,000 triangles more, all passes together.
        // Most of those triangles are not drawn: from where the main camera is, the balls,
        // the capsule and the torus look the same at a coarser level of detail, in every
        // pass and shadow map, and so are drawn with a half to an eighth of theirs. Meshes
        // of one kind at different levels are draw calls of their own.
        "drawCalls": 164,
        "triangles": 17500,
        // Passes over the whole picture: the two of the ambient occlusion, the lighting,
        // the three of the depth of field, and what finishes the picture as the scene
        // says - five levels of bloom down and up, the automatic exposure, the final pass
        // and the smoothing of its edges.
        "screenPasses": 18,
        // The image the ambient occlusion is worked out in: at medium quality a texel
        // for one pixel in four of the 960 by 540 the tests draw, two half floats each.
        "ambientOcclusionBytes": 518400,
        // The two images the depth of field is worked out in: a texel for every four
        // pixels, four half floats each.
        "depthOfFieldBytes": 2073600,
        // The main camera has the sun behind it: no light shafts.
        "lightShaftBytes": 0,
        // The three decals of the showcase are in view: the grime and the warning strip on
        // the floor, the grime on the wall. The grime comes to where the strip, which is
        // laid on first, bent the normals: they are copied for it a second time. The copy
        // is as large as the picture, two 16-bit numbers a pixel.
        "decals": 3,
        "decalNormalCopies": 2,
        "decalBytes": 2073600,
        // The lights in view, and the entries of the cluster lists they are in: how
        // many clusters the lamps of the showcase reach, all of them together. The
        // light at the sentry's post is among them also while it is dark: a script
        // gives it its brightness, and a light of none is a light still.
        "lights": 6,
        "lightListEntries": 1310,
        // Three cascades for the sun, one map for the lamp, six for the wall light, in
        // the atlas of the medium shadow quality: 4096 texels a side, four bytes each.
        "shadowMaps": 12,
        "shadowAtlasBytes": 67108864,
        // The cube map made of the sky, for reflections: six faces of 256 texels a side
        // and five smaller levels of them, eight bytes a texel. One environment, one
        // cube map.
        "environmentBytes": 4193280,
        // The levels of detail of the meshes of many triangles add their indices.
        "meshBytes": 165000,
        // What is simulated: the bodies of the scene - of which three are awake at most
        // once the rest has settled, the two triggers and the body that stands for the
        // character; two of those that stand still are the bollards - the shapes that
        // were made of meshes for their colliders, the joints that hold bodies together,
        // the characters, and the joints its animators pose.
        "bodies": 19,
        "geometries": 2,
        "physicsJoints": 5,
        "characters": 1,
        "joints": 8,
        // What is scripted: the scripts that are loaded - the clock, the patrol of the
        // sentry, the self-test of the script API, the lamp that flickers, and the three
        // that only hear what they are told: the sentry's post, the ball, and the way out
        // to the annex - and the entities that run one. The functions of scripts a frame
        // calls: the updates of the patrol and of the self-test, and in some frames the
        // timer of the clock, the task of the lamp, and the post when the sentry walks
        // into its trigger or out of it. What waits for its time: that timer, that task,
        // and for a moment the timer that lets the post's light go out. The memory all of Lua
        // holds: 82 kB stay - the runtime with the functions it gives scripts, and the
        // seven scripts, of which the self-test is half - and Lua lets what it holds
        // double before it collects.
        "scripts": 7,
        "scriptInstances": 7,
        "scriptCalls": 5,
        "scriptTimers": 3,
        "scriptBytes": 175000,
        // What is heard: the voices that sound at once - the hum of the lamp and the
        // music, and for a moment now and then the tick of the clock and the call at
        // the sentry's post - and the samples of their sounds in memory, four bytes
        // each: the hum is 44100 of them, the music 88200, the call 8820 and the tick
        // 1103.
        "audioVoices": 4,
        "soundBytes": 568892,
        // The image of the sky is 1.4 MiB of this, the three images of the grime of the
        // decals 1 MiB.
        "textureBytes": 10485760,

        "milliseconds": {
            "assetIndex": 500,
            "assetLoad": 1000,
            "coldStart": 15000,
            "warmStart": 5000,
            "sceneLoad": 100,
            "firstFrame": 5000,
            "cpuFrameMedian": 5,
            "gpuFrameMedian": 5,
            // What the seven scripts take of a frame: a few hundredths of a millisecond,
            // of which counting their instructions is four tenths. The worst frame is
            // one in which Lua collects what the others left behind.
            "scriptsMedian": 0.5,
            "scriptsMaximum": 5
        }
    },

    // Six hundred point and spot lights over a field of four hundred crates and balls,
    // none of them casting a shadow; see tests/perf/LightingPerformanceTests.cpp.
    "lights": {
        // The crates of the field are a draw call a pass, its balls one for each of the
        // three levels of detail they are drawn at, the floor one.
        "drawCalls": 10,
        // The ambient occlusion, the lighting and what finishes a picture when a scene
        // says nothing: bloom, the final pass and the smoothing of its edges.
        "screenPasses": 14,
        "ambientOcclusionBytes": 518400,
        // A scene that says nothing has no depth of field, and no light shafts; the field
        // has no decals.
        "depthOfFieldBytes": 0,
        "lightShaftBytes": 0,
        "decals": 0,
        "decalNormalCopies": 0,
        "decalBytes": 0,
        // The balls of the field are drawn at coarser levels of detail the further they are.
        "triangles": 60000,
        // Most of the lights are in view. The entries of the cluster lists say how well
        // they are told apart: the number goes up when lights are put into the lists of
        // clusters they do not reach, and every entry is a light a pixel has to ask.
        "lights": 600,
        "lightListEntries": 22500,
        // No shadows: the atlas stays as small as an atlas can be.
        "shadowMaps": 0,
        "shadowAtlasBytes": 16384,

        "milliseconds": {
            // Gathering the lights from the world, sorting them into the clusters and
            // planning their shadow maps - here, finding that none wants any: what the
            // CPU does for the lights for every view of every frame.
            "lightCollectMedian": 2,
            "lightClustersMedian": 5,
            "shadowPlanMedian": 1,
            "cpuFrameMedian": 10,
            "gpuFrameMedian": 10
        }
    },

    // The same field, with the sun and twelve of the lights casting shadows.
    "shadows": {
        // Four cascades, four spot lights with a map each and eight point lights with
        // six: each map draws what its light reaches of the field once more, in up to
        // three draw calls.
        "shadowMaps": 60,
        "shadowAtlasBytes": 67108864,
        "drawCalls": 165,
        "screenPasses": 14,
        "ambientOcclusionBytes": 518400,
        "depthOfFieldBytes": 0,
        "lightShaftBytes": 0,
        "decals": 0,
        "decalNormalCopies": 0,
        "decalBytes": 0,
        // The shadow maps draw the balls at the levels the camera sees them at.
        "triangles": 145000,
        "lights": 600,
        "lightListEntries": 22500,

        "milliseconds": {
            "lightCollectMedian": 2,
            "lightClustersMedian": 5,
            // Choosing which of the lights get shadow maps, and where each map goes.
            "shadowPlanMedian": 1,
            "cpuFrameMedian": 15,
            "gpuFrameMedian": 15
        }
    }
}
