// What the scenarios of the performance tests may cost.
// See tests/perf/PerformanceTestSupport.h, and `scripts/dev.ps1 perf` for the numbers of
// this machine.
//
// Counts and sizes are the same on every machine. They leave room for a small addition
// and no more: a change that exceeds one either has a reason, and raises the budget in
// the same commit, or has a mistake.
//
// Times depend on the machine and on what else it is doing, so their budgets are many
// times what a desktop GPU needs. They catch what has become very much slower, not what
// has become a little slower; for that, compare runs of `dev.ps1 perf`. They are checked
// in optimized builds only.
{
    // The showcase project, as a game shows it.
    "showcase": {
        // Draw calls and triangles are those of all passes together: a solid surface is
        // drawn by the depth pre-pass and again by the base pass, a translucent one
        // once, and whatever stands in the light of a light that casts shadows once
        // more for each of its shadow maps. Two thirds of both are the shadow maps. The
        // hoist is in them with its frame and with its cable, which is skinned: three
        // draw calls a pass that sees all of it. The rack by the wall is two balls and
        // four boxes more - the balls of 960 triangles each, in every pass and every
        // shadow map that sees them - and the sentry a capsule of 1024, which six of
        // them see.
        "drawCalls": 150,
        "triangles": 37500,
        // Passes over the whole picture: the two of the ambient occlusion, the lighting,
        // and what finishes the picture as the scene says - five levels of bloom down
        // and up, the automatic exposure, the final pass and the smoothing of its edges.
        "screenPasses": 15,
        // The image the ambient occlusion is worked out in: at medium quality a texel
        // for one pixel in four of the 960 by 540 the tests draw, two half floats each.
        "ambientOcclusionBytes": 518400,
        // The lights in view, and the entries of the cluster lists they are in: how
        // many clusters the lamps of the showcase reach, all of them together.
        "lights": 6,
        "lightListEntries": 1250,
        // Three cascades for the sun, one map for the lamp, six for the wall light, in
        // the atlas of the medium shadow quality: 4096 texels a side, four bytes each.
        "shadowMaps": 12,
        "shadowAtlasBytes": 67108864,
        // The cube map made of the sky, for reflections: six faces of 256 texels a side
        // and five smaller levels of them, eight bytes a texel. One environment, one
        // cube map.
        "environmentBytes": 4193280,
        "meshBytes": 160000,
        // What is simulated: the bodies of the scene - of which two are awake at most
        // once the rest has settled, the trigger and the body that stands for the
        // character - the shapes that were made of meshes for their colliders, the
        // joints that hold bodies together, the characters, and the joints its animators
        // pose.
        "bodies": 16,
        "geometries": 2,
        "physicsJoints": 5,
        "characters": 1,
        "joints": 8,
        // What is scripted: the scripts that are loaded, the entities that run one, the
        // functions of scripts a frame calls - an update for each that has one - and
        // the memory all of Lua holds. What stays is 17 kB, nearly all of it the runtime
        // itself; the clock makes a name twice a second, and Lua lets what it holds
        // double before it collects.
        "scripts": 1,
        "scriptInstances": 1,
        "scriptCalls": 1,
        "scriptBytes": 40000,
        // The image of the sky is 1.4 MiB of this.
        "textureBytes": 9437184,

        "milliseconds": {
            "assetIndex": 500,
            "assetLoad": 1000,
            "coldStart": 15000,
            "warmStart": 5000,
            "sceneLoad": 100,
            "firstFrame": 5000,
            "cpuFrameMedian": 5,
            "gpuFrameMedian": 5
        }
    },

    // Six hundred point and spot lights over a field of four hundred crates and balls,
    // none of them casting a shadow; see tests/perf/LightingPerformanceTests.cpp.
    "lights": {
        // The field is two draw calls a pass, the floor one.
        "drawCalls": 6,
        // The ambient occlusion, the lighting and what finishes a picture when a scene
        // says nothing: bloom, the final pass and the smoothing of its edges.
        "screenPasses": 14,
        "ambientOcclusionBytes": 518400,
        "triangles": 340000,
        // Most of the lights are in view. The entries of the cluster lists say how well
        // they are told apart: the number goes up when lights are put into the lists of
        // clusters they do not reach, and every entry is a light a pixel has to ask.
        "lights": 600,
        "lightListEntries": 22500,
        // No shadows: the atlas stays as small as an atlas can be.
        "shadowMaps": 0,
        "shadowAtlasBytes": 16384,

        "milliseconds": {
            // Gathering the lights from the world, sorting them into the clusters and
            // planning their shadow maps - here, finding that none wants any: what the
            // CPU does for the lights for every view of every frame.
            "lightCollectMedian": 2,
            "lightClustersMedian": 5,
            "shadowPlanMedian": 1,
            "cpuFrameMedian": 10,
            "gpuFrameMedian": 10
        }
    },

    // The same field, with the sun and twelve of the lights casting shadows.
    "shadows": {
        // Four cascades, four spot lights with a map each and eight point lights with
        // six: each map draws what its light reaches of the field once more, in up to
        // three draw calls.
        "shadowMaps": 60,
        "shadowAtlasBytes": 67108864,
        "drawCalls": 165,
        "screenPasses": 14,
        "ambientOcclusionBytes": 518400,
        "triangles": 800000,
        "lights": 600,
        "lightListEntries": 22500,

        "milliseconds": {
            "lightCollectMedian": 2,
            "lightClustersMedian": 5,
            // Choosing which of the lights get shadow maps, and where each map goes.
            "shadowPlanMedian": 1,
            "cpuFrameMedian": 15,
            "gpuFrameMedian": 15
        }
    }
}
