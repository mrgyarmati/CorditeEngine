---
# Cordite C++ style. Formatting is enforced with clang-format 19 (scripts/dev.ps1 format).
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20

ColumnLimit: 120
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: true
IndentPPDirectives: None

PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
QualifierAlignment: Leave

AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
InsertBraces: true

BreakTemplateDeclarations: Yes
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLine
BinPackArguments: true
BinPackParameters: true
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
Cpp11BracedListStyle: true
SpaceAfterTemplateKeyword: true

EmptyLineBeforeAccessModifier: LogicalBlock
SeparateDefinitionBlocks: Always
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfBlock: false
  AtStartOfFile: false
  AtEndOfFile: false
FixNamespaceComments: true
InsertNewlineAtEOF: true

# The header matching the source file comes first, then engine headers, then
# third-party headers, then the standard library.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeIsMainRegex: '(Tests)?$'
IncludeCategories:
  - Regex: '^"cordite/'
    Priority: 1
  - Regex: '^"'
    Priority: 2
  - Regex: '^<[a-z_]+>$'
    Priority: 4
  - Regex: '^<'
    Priority: 3
...
