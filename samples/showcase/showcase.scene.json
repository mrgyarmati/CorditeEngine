            "enabled": true,
            "parent": "10000000-0000-4000-8000-000000000005",
            "components": {
                "Transform": { "position": [1.0, 0.3, 0.0], "rotation": [0.0, 0.0, 0.0, 1.0], "scale": [0.6, 0.6, 0.6] }
            }
        },
        {
            "id": "10000000-0000-4000-8000-000000000007",
            "name": "Cameras",
            "enabled": true,
            "parent": null,
            "components": {
                "Transform": { "position": [0.0, 0.0, 0.0], "rotation": [0.0, 0.0, 0.0, 1.0], "scale": [1.0, 1.0, 1.0] }
            }
        },
        {
            // The camera the game renders from: up and to the side, looking at the stage.
            "id": "10000000-0000-4000-8000-000000000008",
