{
    // The engine's showcase: one scene that uses every component and every kind of
    // setting the engine has. It is opened by the tests and by the editor's smoke test,
    // and it is the place to look for an example of how something is written in a scene
    // file. When a component is added to the engine, it is added here too; a test fails
    // until it is (tests/unit/samples/ShowcaseSceneTests.cpp).
    "format": "cordite.scene",
    "version": 1,
    "name": "Showcase",
    "entities": [
        {
            "id": "10000000-0000-4000-8000-000000000001",
            "name": "Stage",
            "enabled": true,
            "parent": null,
            "components": {
                "Transform": { "position": [0.0, 0.0, 0.0], "rotation": [0.0, 0.0, 0.0, 1.0], "scale": [1.0, 1.0, 1.0] }
            }
        },
        {
            // Turned 30 degrees about the vertical axis.
            "id": "10000000-0000-4000-8000-000000000002",
            "name": "Crate",
            "enabled": true,
            "parent": "10000000-0000-4000-8000-000000000001",
            "components": {
                "Transform": {
                    "position": [2.0, 0.5, -1.0],
                    "rotation": [0.0, 0.25881904, 0.0, 0.9659258],
                    "scale": [1.0, 1.0, 1.0]
                }
            }
        },
        {
            // A child inherits the placement of its parent: the lid turns with the crate.
            "id": "10000000-0000-4000-8000-000000000003",
            "name": "Lid",
            "enabled": true,
            "parent": "10000000-0000-4000-8000-000000000002",
            "components": {
                "Transform": { "position": [0.0, 0.55, 0.0], "rotation": [0.0, 0.0, 0.0, 1.0], "scale": [1.1, 0.1, 1.1] }
            }
        },
        {
            "id": "10000000-0000-4000-8000-000000000004",
            "name": "Pillar",
            "enabled": true,
            "parent": "10000000-0000-4000-8000-000000000001",
            "components": {
                "Transform": { "position": [-3.0, 1.5, -2.0], "rotation": [0.0, 0.0, 0.0, 1.0], "scale": [0.5, 3.0, 0.5] }
            }
        },
        {
            // Disabled entities stay in the scene but are ignored, with everything below them.
            "id": "10000000-0000-4000-8000-000000000005",
            "name": "Spare parts",
            "enabled": false,
            "parent": "10000000-0000-4000-8000-000000000001",
            "components": {
                "Transform": { "position": [0.0, 0.0, -4.0], "rotation": [0.0, 0.0, 0.0, 1.0], "scale": [1.0, 1.0, 1.0] }
