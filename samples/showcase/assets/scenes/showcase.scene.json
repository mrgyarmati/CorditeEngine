        {
            // The lamp in the head: a spot light. It shines along the -Z axis of its entity,
            // which a quarter turn about X points out of the underside of the head, and so
            // it follows wherever the head is turned. Inside the inner cone it is at full
            // brightness; from there it fades to nothing at the outer one. Its range is no
            // more than the floor below it needs: a light costs what it can reach.
            // It shines through a wire guard - its `cookie`, textures/lamp_cookie.png - which
            // lays the shadows of the bars on the floor, and dims the light towards its rim.
            // In the haze it is a cone of light: `volumetricIntensity` has it light the fog
            // ten times as brightly as its intensity alone would - a lamp in haze is what
            // the eye goes to.
            "id": "10000000-0000-4000-8000-000000000022",
            "name": "Lamp",
            "enabled": true,
            "parent": "10000000-0000-4000-8000-000000000015",
            "components": {
                "Transform": {
                    "position": [0.0, -0.1, 0.0],
                    "rotation": [-0.70710677, 0.0, 0.0, 0.70710677],
                    "scale": [1.0, 1.0, 1.0]
                },
                "Light": {
                    "type": "spot",
                    "color": [1.0, 0.9, 0.75],
                    "intensity": 13.5,
                    "range": 6.0,
                    "innerConeDegrees": 28.0,
                    "outerConeDegrees": 44.0,
                    "channels": 1,
                    "castsShadows": true,
                    "shadowResolution": "high",
                    "cookie": "0431528e-40b4-8300-9814-94cd5283aeac",
                    "volumetricIntensity": 10.0
                },
                // It flickers: scripts/flicker.lua lets it burn steadily for a few seconds,
                // dips its brightness three times in a row, and lets it burn on.
                "Script": { "script": "fba9a526-fe5b-89d4-8f8c-740b56e542e0", "properties": {} },
                // And it hums. A sound that is heard from where its entity is: as loud as it
                // gets within `minDistance` of whoever listens, and with a linear rolloff
                // quieter evenly from there to nothing at `maxDistance` - a lamp is not heard
                // across a yard. It is at the side it is at, to the ear on that side. `loop`
                // lets sounds/hum.wav, two seconds long, go round without an end, and
                // `playing` in a scene file says that it sounds from the moment the scene
                // starts. The ambience bus is what a place sounds like; every bus has a
                // volume that everything on it shares.
                "AudioSource": {
                    "sound": "b7e9c82b-9bcd-8d53-9146-03b3e93e3b40",
                    "bus": "ambience",
                    "playing": true,
                    "loop": true,
                    "volume": 0.6,
                    "pitch": 1.0,
                    "spatial": true,
                    "rolloff": "linear",
                    "minDistance": 1.5,
                    "maxDistance": 14.0
                }
            }
        },
